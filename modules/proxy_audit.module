#!name=节点观测站
#!desc=访问 https://audit.test 对当前代理出口执行完整、只读的身份、信誉、性能与服务入口检测
#!author=jaychou0642-create
#!homepage=https://github.com/jaychou0642-create/shadowrocket-fixed-sub

[Script]
# 全新移动端观测面板
Proxy-Observatory-Front = type=http-request, pattern=^https:\/\/audit\.test\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/jaychou0642-create/shadowrocket-fixed-sub/main/modules/js/audit-front.js, timeout=30

# 完整探针：出口身份、8 轮延迟、2 x 10 MB 测速、信誉源与服务入口
Proxy-Observatory-API = type=http-request, pattern=^https:\/\/audit\.test\/api\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/jaychou0642-create/shadowrocket-fixed-sub/main/modules/js/audit-api.js, timeout=90

[MITM]
hostname = %APPEND% audit.test
