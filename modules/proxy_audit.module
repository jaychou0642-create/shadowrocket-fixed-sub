#!name=节点观测站
#!desc=访问 https://audit.test 后手动检测当前代理出口；延迟、GPT 链路与下载速度合并按需测试
#!author=jaychou0642-create
#!homepage=https://github.com/jaychou0642-create/shadowrocket-fixed-sub

[Script]
# 全新移动端观测面板
Proxy-Observatory-Front = type=http-request, pattern=^https:\/\/audit\.test\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/jaychou0642-create/shadowrocket-fixed-sub/main/modules/js/audit-front.js?v=2.8.1, timeout=30

# 手动探针：出口身份、信誉源、AI入口与流媒体；性能按钮依次执行延迟、GPT 链路及渐进下载测速
Proxy-Observatory-API = type=http-request, pattern=^https:\/\/audit\.test\/api\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/jaychou0642-create/shadowrocket-fixed-sub/main/modules/js/audit-api.js?v=2.8.1, timeout=90

[MITM]
hostname = %APPEND% audit.test
